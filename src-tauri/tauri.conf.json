{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EzAddon",
  "version": "0.1.0",
  "identifier": "com.ritualkit.ezaddon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EzAddon \u2014 WoW Forever addons",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "WoW Forever addon manager",
    "longDescription": "Browse, install and update World of Warcraft: Forever addons from CurseForge.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NUEyMzA1RTQ1M0U2QkUKUldTKzVsUGtCU05haGhBZVNNL3o2b2ZyajRuUlYvTEdXYlpvSjkwbTUzSC9lMmdRMTFyclJ4Zk8K",
      "endpoints": [
        "https://github.com/RitualKit/EzAddon/releases/download/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
